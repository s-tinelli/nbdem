+TEST(nb_dem, x_error_columns_merge) {
+    Circuit c(R"CIRCUIT(
+        R 0 1 2 3
+        X_ERROR(0.001) 0 1 2 3
+        M 0 1 2 3
+        DETECTOR rec[-4] rec[-3]
+    )CIRCUIT");
+    NonbinaryDem nb = circuit_to_nonbinary_dem(c);
+    // Errors on qubits 0 and 1 flip the detector; errors on 2 and 3 flip nothing.
+    // The two parts merge into one mechanism, assigned to the earlier location
+    // (qubit 0) by the rank-first tie-breaking.
+    ASSERT_EQ(nb.columns.size(), 1);
+    ASSERT_EQ(nb.columns[0].rank, 1);
+    ASSERT_EQ(nb.columns[0].origins.size(), 1);
+    ASSERT_EQ(nb.columns[0].origins[0], "X_ERROR(0.001) 0");
+    ASSERT_EQ(nb.columns[0].detector_edges.size(), 1);
+    ASSERT_NEAR(nb.columns[0].prior[0], 1 - 0.0019980000000000, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[1], 0.0019980000000000, 1e-12);
+    expect_nb_equivalent_to_stim_dem(c);
+}
