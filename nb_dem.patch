+namespace stim {
+
+NonbinaryDem circuit_to_nonbinary_dem(const Circuit &circuit, NbDemOptions options) {
+    // ------------------------------------------------------------------
+    // Phase 1: unroll loops, walk the circuit backward with Stim's error
+    // analyzer as a sensitivity tracker, and record one raw column per
+    // noise channel application.
+    // ------------------------------------------------------------------
+    Circuit flat = circuit.flattened();
+
+    NbDemContext ctx;
+    ctx.num_detectors = flat.count_detectors();
+    ctx.num_observables = flat.count_observables();
+
+    std::vector<RawColumn> raw_columns;
+
+    ErrorAnalyzer analyzer(
+        flat.count_measurements(),
+        ctx.num_detectors,
+        flat.count_qubits(),
+        flat.count_ticks(),
+        /*decompose_errors=*/false,
+        /*fold_loops=*/false,
+        options.allow_gauge_detectors,
+        /*approximate_disjoint_errors_threshold=*/1.0,
+        /*ignore_decomposition_failures=*/false,
+        /*block_decomposition_from_introducing_remnant_edges=*/false);
+    analyzer.accumulate_errors = false;
+    analyzer.current_circuit_being_analyzed = &flat;
+
+    auto sym_of_x_error = [&](uint32_t q) {
+        return symptom_from_targets(ctx, analyzer.tracker.zs[q].range());
+    };
+    auto sym_of_z_error = [&](uint32_t q) {
+        return symptom_from_targets(ctx, analyzer.tracker.xs[q].range());
+    };
+    auto sym_of_rec = [&](uint64_t rec) -> Symptom {
+        auto it = analyzer.tracker.rec_bits.find(rec);
+        if (it != analyzer.tracker.rec_bits.end()) {
+            return symptom_from_targets(ctx, it->second.range());
+        }
+        return Symptom(ctx.num_bits());
+    };
+
+    auto add_raw = [&](RawColumn &&col) {
+        raw_columns.push_back(std::move(col));
+    };
+
+    size_t num_ops = flat.operations.size();
+    std::vector<CircuitInstruction> pending_else_chain;
+
+    // Records the flip columns of a measurement instruction. For per_pair
+    // instructions (MXX/MYY/MZZ) each target pair produces one result.
+    auto record_measurement_flips = [&](const CircuitInstruction &op, size_t fwd_index, bool per_pair) {
+        if (op.args.empty() || op.args[0] <= 0) {
+            return;
+        }
+        uint64_t base = analyzer.tracker.num_measurements_in_past;
+        size_t num_results = per_pair ? op.targets.size() / 2 : op.targets.size();
+        for (size_t j = 0; j < num_results; j++) {
+            Symptom s = sym_of_rec(base - num_results + j);
+            if (s.is_zero()) {
+                continue;  // Nothing depends on this result.
+            }
+            RawColumn col;
+            uint32_t q = op.targets[per_pair ? 2 * j : j].qubit_value();
+            std::vector<GateTarget> tg{op.targets[per_pair ? 2 * j : j]};
+            if (per_pair) {
+                tg.push_back(op.targets[2 * j + 1]);
+            }
+            col.order = {fwd_index, j};
+            col.description = CircuitInstruction{op.gate_type, op.args, tg, op.tag}.str() + " (result flip)";
+            col.tag = std::string(op.tag);
+            col.generators = {s};
+            col.generator_labels = {"flip@" + std::to_string(q)};
+            col.prior = {{1, op.args[0]}};
+            add_raw(std::move(col));
+        }
+    };
+
+    for (size_t k = num_ops; k--;) {
+        const CircuitInstruction &op = flat.operations[k];
+        size_t fwd_index = k;
+
+        switch (op.gate_type) {
+            case GateType::X_ERROR:
+            case GateType::Y_ERROR:
+            case GateType::Z_ERROR: {
+                if (op.args.empty() || op.args[0] <= 0) {
+                    break;
+                }
+                for (size_t j = 0; j < op.targets.size(); j++) {
+                    uint32_t q = op.targets[j].qubit_value();
+                    RawColumn col;
+                    std::vector<GateTarget> tg{op.targets[j]};
+                    col.order = {fwd_index, j};
+                    col.description = CircuitInstruction{op.gate_type, op.args, tg, op.tag}.str();
+                    col.tag = std::string(op.tag);
+                    if (op.gate_type == GateType::X_ERROR) {
+                        col.generators = {sym_of_x_error(q)};
+                        col.generator_labels = {"X@" + std::to_string(q)};
+                        col.prior = {{1, op.args[0]}};
+                    } else if (op.gate_type == GateType::Z_ERROR) {
+                        col.generators = {sym_of_z_error(q)};
+                        col.generator_labels = {"Z@" + std::to_string(q)};
+                        col.prior = {{1, op.args[0]}};
+                    } else {
+                        col.generators = {sym_of_x_error(q), sym_of_z_error(q)};
+                        col.generator_labels = {"X@" + std::to_string(q), "Z@" + std::to_string(q)};
+                        col.prior = {{3, op.args[0]}};
+                    }
+                    add_raw(std::move(col));
+                }
+                break;
+            }
+
+            case GateType::DEPOLARIZE1:
+            case GateType::PAULI_CHANNEL_1: {
+                double px, py, pz;
+                if (op.gate_type == GateType::DEPOLARIZE1) {
+                    px = py = pz = op.args[0] / 3;
+                } else {
+                    px = op.args[0];
+                    py = op.args[1];
+                    pz = op.args[2];
+                }
+                if (px <= 0 && py <= 0 && pz <= 0) {
+                    break;
+                }
+                for (size_t j = 0; j < op.targets.size(); j++) {
+                    uint32_t q = op.targets[j].qubit_value();
+                    RawColumn col;
+                    std::vector<GateTarget> tg{op.targets[j]};
+                    col.order = {fwd_index, j};
+                    col.description = CircuitInstruction{op.gate_type, op.args, tg, op.tag}.str();
+                    col.tag = std::string(op.tag);
+                    // Coordinates: bit 0 = X component, bit 1 = Z component.
+                    col.generators = {sym_of_x_error(q), sym_of_z_error(q)};
+                    col.generator_labels = {"X@" + std::to_string(q), "Z@" + std::to_string(q)};
+                    if (px > 0) {
+                        col.prior.push_back({0b01, px});
+                    }
+                    if (pz > 0) {
+                        col.prior.push_back({0b10, pz});
+                    }
+                    if (py > 0) {
+                        col.prior.push_back({0b11, py});
+                    }
+                    add_raw(std::move(col));
+                }
+                break;
+            }
+
+            case GateType::DEPOLARIZE2:
+            case GateType::PAULI_CHANNEL_2: {
+                double p15[15];
+                bool all_zero = true;
+                if (op.gate_type == GateType::DEPOLARIZE2) {
+                    for (size_t t = 0; t < 15; t++) {
+                        p15[t] = op.args[0] / 15;
+                        all_zero &= p15[t] <= 0;
+                    }
+                } else {
+                    for (size_t t = 0; t < 15; t++) {
+                        p15[t] = op.args[t];
+                        all_zero &= p15[t] <= 0;
+                    }
+                }
+                if (all_zero) {
+                    break;
+                }
+                for (size_t j = 0; 2 * j + 1 < op.targets.size(); j++) {
+                    uint32_t qa = op.targets[2 * j].qubit_value();
+                    uint32_t qb = op.targets[2 * j + 1].qubit_value();
+                    RawColumn col;
+                    std::vector<GateTarget> tg{op.targets[2 * j], op.targets[2 * j + 1]};
+                    col.order = {fwd_index, j};
+                    col.description = CircuitInstruction{op.gate_type, op.args, tg, op.tag}.str();
+                    col.tag = std::string(op.tag);
+                    // Coordinates: bit0 = X@a, bit1 = Z@a, bit2 = X@b, bit3 = Z@b.
+                    col.generators = {
+                        sym_of_x_error(qa), sym_of_z_error(qa), sym_of_x_error(qb), sym_of_z_error(qb)};
+                    col.generator_labels = {
+                        "X@" + std::to_string(qa),
+                        "Z@" + std::to_string(qa),
+                        "X@" + std::to_string(qb),
+                        "Z@" + std::to_string(qb)};
+                    if (op.gate_type == GateType::DEPOLARIZE2) {
+                        for (uint64_t u = 1; u < 16; u++) {
+                            col.prior.push_back({u, p15[0]});
+                        }
+                    } else {
+                        // Argument t is the probability of the two-qubit Pauli
+                        // whose first-qubit (a) xyz code is ((t+1)>>2)&3 and
+                        // second-qubit (b) xyz code is (t+1)&3.
+                        for (size_t t = 0; t < 15; t++) {
+                            if (p15[t] <= 0) {
+                                continue;
+                            }
+                            uint64_t xz_a = pauli_xyz_to_xz(((t + 1) >> 2) & 3);
+                            uint64_t xz_b = pauli_xyz_to_xz((t + 1) & 3);
+                            uint64_t u = xz_a | (xz_b << 2);
+                            col.prior.push_back({u, p15[t]});
+                        }
+                    }
+                    add_raw(std::move(col));
+                }
+                break;
+            }
+
+            case GateType::HERALDED_ERASE:
+            case GateType::HERALDED_PAULI_CHANNEL_1: {
+                double pi_i, pi_x, pi_z, pi_y;
+                if (op.gate_type == GateType::HERALDED_ERASE) {
+                    double p = op.args[0];
+                    pi_i = pi_x = pi_z = pi_y = p / 4;
+                } else {
+                    pi_i = op.args[0];
+                    pi_x = op.args[1];
+                    pi_y = op.args[2];
+                    pi_z = op.args[3];
+                }
+                if (pi_i <= 0 && pi_x <= 0 && pi_y <= 0 && pi_z <= 0) {
+                    break;
+                }
+                uint64_t base = analyzer.tracker.num_measurements_in_past;
+                size_t T = op.targets.size();
+                for (size_t j = 0; j < T; j++) {
+                    uint32_t q = op.targets[j].qubit_value();
+                    RawColumn col;
+                    std::vector<GateTarget> tg{op.targets[j]};
+                    col.order = {fwd_index, j};
+                    col.description = CircuitInstruction{op.gate_type, op.args, tg, op.tag}.str();
+                    col.tag = std::string(op.tag);
+                    // Coordinates: bit0 = X@q, bit1 = Z@q, bit2 = herald record.
+                    Symptom herald = sym_of_rec(base - T + j);
+                    col.generators = {sym_of_x_error(q), sym_of_z_error(q), herald};
+                    col.generator_labels = {
+                        "X@" + std::to_string(q), "Z@" + std::to_string(q), "H@" + std::to_string(q)};
+                    if (pi_i > 0) {
+                        col.prior.push_back({0b100, pi_i});
+                    }
+                    if (pi_x > 0) {
+                        col.prior.push_back({0b101, pi_x});
+                    }
+                    if (pi_z > 0) {
+                        col.prior.push_back({0b110, pi_z});
+                    }
+                    if (pi_y > 0) {
+                        col.prior.push_back({0b111, pi_y});
+                    }
+                    add_raw(std::move(col));
+                }
+                break;
+            }
+
+            case GateType::M:
+            case GateType::MX:
+            case GateType::MY:
+            case GateType::MR:
+            case GateType::MRX:
+            case GateType::MRY: {
+                record_measurement_flips(op, fwd_index, false);
+                break;
+            }
+
+            case GateType::MXX:
+            case GateType::MYY:
+            case GateType::MZZ: {
+                record_measurement_flips(op, fwd_index, true);
+                break;
+            }
+
+            case GateType::MPP:
+            case GateType::SPP:
+            case GateType::SPP_DAG: {
+                if (!op.args.empty() && op.args[0] > 0) {
+                    throw std::invalid_argument(
+                        std::string("analyze_errors_nb: the noise argument of ") + op.str() +
+                        " is not supported by the non-binary detector error model construction.");
+                }
+                break;
+            }
+
+            case GateType::E:
+            case GateType::ELSE_CORRELATED_ERROR: {
+                pending_else_chain.push_back(op);
+                if (op.gate_type == GateType::E) {
+                    // Chain members in forward order: the E first, then the ELSEs.
+                    std::vector<CircuitInstruction> members(
+                        pending_else_chain.rbegin(), pending_else_chain.rend());
+                    pending_else_chain.clear();
+                    // Conditional (disjoint) probabilities.
+                    double remaining = 1.0;
+                    std::vector<double> conditional;
+                    for (const auto &m : members) {
+                        double p = m.args[0];
+                        conditional.push_back(p * remaining);
+                        remaining *= 1 - p;
+                    }
+                    // One raw column per chain: generators are the per-qubit
+                    // X/Z Pauli components, in order of first appearance; the
+                    // prior is the exact disjoint distribution.
+                    RawColumn col;
+                    col.order = {fwd_index, 0};
+                    col.tag = std::string(members[0].tag);
+                    col.description = members[0].str();
+                    for (size_t mi = 1; mi < members.size(); mi++) {
+                        col.description += " ; " + members[mi].str();
+                    }
+                    auto find_or_add_generator = [&](const Symptom &s, const std::string &label) -> size_t {
+                        for (size_t i = 0; i < col.generator_labels.size(); i++) {
+                            if (col.generator_labels[i] == label) {
+                                return i;
+                            }
+                        }
+                        col.generators.push_back(s);
+                        col.generator_labels.push_back(label);
+                        return col.generators.size() - 1;
+                    };
+                    for (size_t mi = 0; mi < members.size(); mi++) {
+                        const auto &m = members[mi];
+                        uint64_t coords = 0;
+                        for (auto t : m.targets) {
+                            uint32_t q = t.qubit_value();
+                            bool px = (t.data & TARGET_PAULI_X_BIT) != 0;
+                            bool pz = (t.data & TARGET_PAULI_Z_BIT) != 0;
+                            if (px) {
+                                size_t g = find_or_add_generator(sym_of_x_error(q), "X@" + std::to_string(q));
+                                coords |= 1ULL << g;
+                            }
+                            if (pz) {
+                                size_t g = find_or_add_generator(sym_of_z_error(q), "Z@" + std::to_string(q));
+                                coords |= 1ULL << g;
+                            }
+                        }
+                        if (conditional[mi] > 0) {
+                            col.prior.push_back({coords, conditional[mi]});
+                        }
+                    }
+                    if (col.generators.size() > 64) {
+                        throw std::invalid_argument(
+                            "analyze_errors_nb: CORRELATED_ERROR chain with more than 64 generators "
+                            "is not supported.");
+                    }
+                    add_raw(std::move(col));
+                }
+                break;
+            }
+
+            default:
+                if (!pending_else_chain.empty()) {
+                    throw std::invalid_argument(
+                        "ELSE_CORRELATED_ERROR wasn't preceded by ELSE_CORRELATED_ERROR or "
+                        "CORRELATED_ERROR (E)");
+                }
+                break;
+        }
+
+        if (op.gate_type != GateType::E && op.gate_type != GateType::ELSE_CORRELATED_ERROR) {
+            analyzer.undo_gate(op);
+        }
+    }
+    if (!pending_else_chain.empty()) {
+        throw std::invalid_argument(
+            "ELSE_CORRELATED_ERROR wasn't preceded by ELSE_CORRELATED_ERROR or CORRELATED_ERROR (E)");
+    }
+    analyzer.post_check_initialization();
+
+    // ------------------------------------------------------------------
+    // Phase 2: reduce raw columns.
+    // ------------------------------------------------------------------
+    std::vector<WorkColumn> columns;
+    for (const auto &raw : raw_columns) {
+        WorkColumn col;
+        if (reduce_raw_column(ctx, raw, col)) {
+            columns.push_back(std::move(col));
+        }
+    }
+
+    if (options.merge == NbDemMergeMode::PARTS) {
+        // --------------------------------------------------------------
+        // Split every factorizable location into its independent binary
+        // parts, merge parts with equal symptoms, assign each merged part
+        // to its origin location of largest rank (ties: earlier circuit
+        // position), and regroup.
+        // --------------------------------------------------------------
+        std::vector<MergedPart> parts;
+        std::map<std::pair<std::vector<uint64_t>, std::string>, size_t> part_index;
+        std::vector<size_t> factorized_indices;
+        std::vector<size_t> kept_whole_indices;
+        for (size_t ci = 0; ci < columns.size(); ci++) {
+            WorkColumn &col = columns[ci];
+            std::vector<double> part_probs;
+            if (try_factorize(col.prior, col.rank, part_probs)) {
+                col.factorized = true;
+                factorized_indices.push_back(ci);
+                for (size_t v = 1; v < (1ULL << col.rank); v++) {
+                    double q = part_probs[v];
+                    if (q <= 0) {
+                        continue;
+                    }
+                    Symptom symptom = col.symptom_of_coord[v];
+                    if (symptom.is_zero()) {
+                        continue;
+                    }
+                    auto key = std::make_pair(symptom.words, col.tag);
+                    auto it = part_index.find(key);
+                    if (it == part_index.end()) {
+                        part_index[key] = parts.size();
+                        parts.push_back(
+                            MergedPart{std::move(symptom), q, col.tag, col.origins[0], col.order, -1, {ci}});
+                    } else {
+                        MergedPart &dst = parts[it->second];
+                        dst.prob = xor_merge_probs(dst.prob, q);
+                        if (col.order < dst.origin_order) {
+                            dst.origin = col.origins[0];
+                            dst.origin_order = col.order;
+                        }
+                        dst.origins.push_back(ci);
+                    }
+                }
+            } else {
+                col.factorized = false;
+                kept_whole_indices.push_back(ci);
+            }
+        }
+
+        // Assign every merged part to its origin location of largest rank,
+        // breaking ties by circuit order in favor of the earlier location.
+        // Locations that were kept whole do not claim parts.
+        for (auto &part : parts) {
+            size_t best = part.origins[0];
+            for (size_t oi = 1; oi < part.origins.size(); oi++) {
+                size_t cand = part.origins[oi];
+                if (columns[cand].rank > columns[best].rank ||
+                    (columns[cand].rank == columns[best].rank &&
+                     columns[cand].order < columns[best].order)) {
+                    best = cand;
+                }
+            }
+            part.owner = (int)best;
+        }
+
+        // Rebuild the factorized columns from their assigned parts.
+        std::vector<AssembleColumn> assemble;
+        for (size_t ci : factorized_indices) {
+            std::vector<size_t> claimed;
+            for (size_t pi = 0; pi < parts.size(); pi++) {
+                if (parts[pi].owner == (int)ci) {
+                    claimed.push_back(pi);
+                }
+            }
+            if (claimed.empty()) {
+                continue;  // Location fully absorbed by other locations.
+            }
+            AssembleColumn ac;
+            ac.order = columns[ci].order;
+            ac.origins = columns[ci].origins;
+            ac.from_parts = true;
+            ac.native_generators = columns[ci].native_generators;
+            ac.native_labels = columns[ci].native_labels;
+            ac.part_ids = claimed;
+            for (size_t pi : claimed) {
+                ac.atoms.push_back({parts[pi].symptom, parts[pi].prob});
+            }
+            assemble.push_back(std::move(ac));
+        }
+        for (size_t ci : kept_whole_indices) {
+            AssembleColumn ac;
+            ac.order = columns[ci].order;
+            ac.origins = columns[ci].origins;
+            ac.from_parts = false;
+            ac.native_generators = columns[ci].native_generators;
+            ac.native_labels = columns[ci].native_labels;
+            for (size_t u = 0; u < columns[ci].prior.size(); u++) {
+                if (columns[ci].prior[u] > 0) {
+                    ac.atoms.push_back({columns[ci].symptom_of_coord[u], columns[ci].prior[u]});
+                }
+            }
+            assemble.push_back(std::move(ac));
+        }
+
+        std::stable_sort(assemble.begin(), assemble.end(), [](const AssembleColumn &a, const AssembleColumn &b) {
+            return a.order < b.order;
+        });
+        return assemble_nonbinary_dem(ctx, options, assemble, parts);
+    }
+
+    // ------------------------------------------------------------------
+    // Merge mode NONE / COLUMNS: assemble directly from the columns.
+    // ------------------------------------------------------------------
+    if (options.merge == NbDemMergeMode::COLUMNS) {
+        std::map<std::vector<std::vector<uint64_t>>, size_t> span_to_index;
+        std::vector<WorkColumn> merged;
+        for (auto &col : columns) {
+            std::vector<std::vector<uint64_t>> key;
+            for (const auto &row : col.basis.rows) {
+                key.push_back(row.words);
+            }
+            auto it = span_to_index.find(key);
+            if (it == span_to_index.end()) {
+                span_to_index[key] = merged.size();
+                merged.push_back(std::move(col));
+            } else {
+                WorkColumn &dst = merged[it->second];
+                dst.prior = xor_convolve(dst.prior, col.prior);
+                if (col.order < dst.order) {
+                    dst.order = col.order;
+                    dst.tag = col.tag;
+                    dst.native_generators = col.native_generators;
+                    dst.native_labels = col.native_labels;
+                    dst.origins.insert(dst.origins.begin(), col.origins.begin(), col.origins.end());
+                } else {
+                    dst.origins.insert(dst.origins.end(), col.origins.begin(), col.origins.end());
+                }
+            }
+        }
+        columns = std::move(merged);
+    }
+
+    std::vector<AssembleColumn> assemble;
+    for (auto &col : columns) {
+        AssembleColumn ac;
+        ac.order = col.order;
+        ac.origins = col.origins;
+        ac.from_parts = false;
+        ac.native_generators = col.native_generators;
+        ac.native_labels = col.native_labels;
+        for (size_t u = 0; u < col.prior.size(); u++) {
+            if (col.prior[u] > 0) {
+                ac.atoms.push_back({col.symptom_of_coord[u], col.prior[u]});
+            }
+        }
+        assemble.push_back(std::move(ac));
+    }
+    std::vector<MergedPart> no_parts;
+    return assemble_nonbinary_dem(ctx, options, assemble, no_parts);
+}
+
+DetectorErrorModel NonbinaryDem::binary_image() const {
+    struct Entry {
+        double probability;
+        std::vector<DemTarget> targets;
+        std::string tag;
+    };
+    std::vector<Entry> entries;
+    for (const auto &col : columns) {
+        for (const auto &part : col.parts) {
+            if (part.probability <= 0) {
+                continue;
+            }
+            if (part.flipped_detectors.empty() && part.flipped_observables.empty()) {
+                continue;
+            }
+            Entry e;
+            e.probability = part.probability;
+            e.tag = part.tag;
+            for (uint32_t d : part.flipped_detectors) {
+                e.targets.push_back(DemTarget::relative_detector_id(d));
+            }
+            for (uint32_t o : part.flipped_observables) {
+                e.targets.push_back(DemTarget::observable_id(o));
+            }
+            entries.push_back(std::move(e));
+        }
+    }
+    std::sort(entries.begin(), entries.end(), [](const Entry &a, const Entry &b) {
+        // Sort by (targets, tag), matching Stim's detector error model order.
+        size_t n = std::min(a.targets.size(), b.targets.size());
+        for (size_t k = 0; k < n; k++) {
+            if (!(a.targets[k] == b.targets[k])) {
+                return a.targets[k] < b.targets[k];
+            }
+        }
+        if (a.targets.size() != b.targets.size()) {
+            return a.targets.size() < b.targets.size();
+        }
+        return a.tag < b.tag;
+    });
+    DetectorErrorModel out;
+    for (const auto &e : entries) {
+        out.append_error_instruction(e.probability, e.targets, e.tag);
+    }
+    return out;
+}
+
+size_t NonbinaryDem::num_detector_edges() const {
+    size_t total = 0;
+    for (const auto &col : columns) {
+        total += col.detector_edges.size();
+    }
+    return total;
+}
+
+namespace {
+std::string json_escape(const std::string &s) {
+    std::stringstream ss;
+    for (char c : s) {
+        switch (c) {
+            case '"':
+                ss << "\\\"";
+                break;
+            case '\\':
+                ss << "\\\\";
+                break;
+            case '\n':
+                ss << "\\n";
+                break;
+            case '\t':
+                ss << "\\t";
+                break;
+            default:
+                if ((unsigned char)c < 0x20) {
+                    char buf[8];
+                    snprintf(buf, sizeof(buf), "\\u%04x", c);
+                    ss << buf;
+                } else {
+                    ss << c;
+                }
+        }
+    }
+    return ss.str();
+}
