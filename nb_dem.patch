+TEST(nb_dem, depolarize2_with_invisible_directions) {
+    Circuit c(R"CIRCUIT(
+        R 0 1
+        X_ERROR(0.125) 0
+        DEPOLARIZE2(0.25) 0 1
+        M 0 1
+        DETECTOR rec[-2]
+        DETECTOR rec[-1]
+    )CIRCUIT");
+    NonbinaryDem nb = circuit_to_nonbinary_dem(c);
+    // The Z components of both qubits commute with the measurement, so the
+    // two-qubit channel reduces to a quaternary column over the X components.
+    ASSERT_EQ(nb.columns.size(), 1);
+    ASSERT_EQ(nb.columns[0].rank, 2);
+    // Exact prior of the reduced channel convolved with the absorbed X_ERROR:
+    // pi''(u) = (1-p) pi'(u) + p pi'(u xor 01) with p = 0.125 and
+    // pi' = (0.8, 1/15, 1/15, 1/15) over the (x0, x1) coordinates.
+    ASSERT_NEAR(nb.columns[0].prior[0], 0.875 * 0.8 + 0.125 / 15.0, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[1], 0.875 / 15.0 + 0.125 * 0.8, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[2], 1.0 / 15, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[3], 1.0 / 15, 1e-12);
+    expect_nb_equivalent_to_stim_dem(c);
+}
