+TEST(nb_dem, pauli_channel_2_exact) {
+    // A PAULI_CHANNEL_2 that factorizes exactly into independent parts:
+    // q_x1 = q_z1 = q_x2 = q_z2 = 0.05. Note that Stim approximates
+    // PAULI_CHANNEL_2 by independent disjoint mechanisms even when the channel
+    // factorizes, so its binary dem does NOT match the exact law here; the
+    // non-binary dem represents the channel exactly.
+    Circuit c(R"CIRCUIT(
+        R 0 1
+        PAULI_CHANNEL_2(0.04286875, 0.00225625, 0.04286875, 0.04286875, 0.00225625, 0.00011875, 0.00225625, 0.00225625, 0.00011875, 0.00000625, 0.00011875, 0.04286875, 0.00225625, 0.00011875, 0.00225625) 0 1
+        M 0 1
+        DETECTOR rec[-2]
+        DETECTOR rec[-1]
+        DETECTOR rec[-2] rec[-1]
+    )CIRCUIT");
+    NonbinaryDem nb = circuit_to_nonbinary_dem(c);
+    // The Z components are invisible to the Z-basis measurements, so the
+    // channel reduces to a quaternary column over the X components.
+    ASSERT_EQ(nb.columns.size(), 1);
+    ASSERT_EQ(nb.columns[0].rank, 2);
+    // Exact prior: independent X components with probability 0.05 per qubit.
+    ASSERT_NEAR(nb.columns[0].prior[0], 0.95 * 0.95, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[1], 0.05 * 0.95, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[2], 0.05 * 0.95, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[3], 0.05 * 0.05, 1e-12);
+    // Parity expectations match the exact channel law.
+    std::vector<bool> dm{true, false};
+    std::vector<bool> om{};
+    ASSERT_NEAR(nb_parity_expectation(nb, dm, om), 1 - 2 * 0.05, 1e-12);
+}
+
+TEST(nb_dem, non_factorizable_channel_kept_whole) {
+    // The paper's example: pi = (1-2a, a, a, 0) for I, X, Z, Y. This channel is
+    // anti-correlated and has no exact binary factorization, so the column is
+    // kept whole with its exact prior. Stim's binary dem approximates it.
+    Circuit c(R"CIRCUIT(
+        R 0 1
+        H 0
+        CX 0 1
+        PAULI_CHANNEL_1(0.05, 0.0, 0.05) 0
+        MPP X0*X1
+        MPP Z0*Z1
+        DETECTOR rec[-2]
+        DETECTOR rec[-1]
+    )CIRCUIT");
+    NonbinaryDem nb = circuit_to_nonbinary_dem(c);
+    ASSERT_EQ(nb.columns.size(), 1);
+    ASSERT_FALSE(nb.columns[0].factorized);
+    ASSERT_EQ(nb.columns[0].rank, 2);
+    // Exact prior of the channel: pi(I) = 0.9, pi(X) = 0.05, pi(Z) = 0.05, pi(Y) = 0.
+    // Coordinates: bit0 = X component, bit1 = Z component.
+    ASSERT_NEAR(nb.columns[0].prior[0], 0.9, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[1], 0.05, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[2], 0.05, 1e-12);
+    ASSERT_NEAR(nb.columns[0].prior[3], 0.0, 1e-12);
+    ASSERT_TRUE(nb.columns[0].parts.empty());
+    // Parity expectations must match the exact channel, not Stim's approximation.
+    // E[(-1)^s0] for the first detector (flipped by the X component): 1 - 2 * 0.05.
+    std::vector<bool> det_mask{true, false};
+    std::vector<bool> obs_mask{};
+    ASSERT_NEAR(nb_parity_expectation(nb, det_mask, obs_mask), 1 - 2 * 0.05, 1e-12);
+}
