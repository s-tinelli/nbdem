+TEST(nb_dem, merge_modes) {
+    Circuit c(R"CIRCUIT(
+        R 0 1 2 3
+        X_ERROR(0.01) 2 3
+        DEPOLARIZE1(0.02) 0 1
+        M 0 1 2 3
+        DETECTOR rec[-4] rec[-3]
+        DETECTOR rec[-2]
+    )CIRCUIT");
+    size_t num[3] = {0, 0, 0};
+    std::map<NbDemMergeMode, size_t> mode_index{
+        {NbDemMergeMode::NONE, 0}, {NbDemMergeMode::COLUMNS, 1}, {NbDemMergeMode::PARTS, 2}};
+    for (auto mode : {NbDemMergeMode::NONE, NbDemMergeMode::COLUMNS, NbDemMergeMode::PARTS}) {
+        NbDemOptions opts;
+        opts.merge = mode;
+        NonbinaryDem nb = circuit_to_nonbinary_dem(c, opts);
+        for (const auto &col : nb.columns) {
+            double total = 0;
+            for (double p : col.prior) {
+                total += p;
+            }
+            ASSERT_NEAR(total, 1.0, 1e-9);
+        }
+        num[mode_index[mode]] = nb.columns.size();
+    }
+    // parts <= columns <= none.
+    ASSERT_LE(num[2], num[1]);
+    ASSERT_LE(num[1], num[0]);
+    ASSERT_EQ(num[2], 2);  // One column for the visible depolarizing channel, one for qubit 2's flip.
+}
