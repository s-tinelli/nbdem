+TEST(nb_dem, assign_uses_origins_only) {
+    // The paper's Assign step lets a part go only to its origin locations, not
+    // to any column whose span contains it. The channel below is the XOR of
+    // independent parts X'~0.2 and Y'~0.1 (so its disjoint probabilities are
+    // px = 0.2*0.9, py = 0.8*0.1, pz = 0.2*0.1): its factorization has parts
+    // only on the X and Y symptoms, so the "Z direction" lies in the column's
+    // span without being one of its parts. A Z_ERROR with that symptom must
+    // keep its own column instead of being absorbed by the higher-rank
+    // channel.
+    Circuit c(R"CIRCUIT(
+        R 0 1
+        H 0
+        CX 0 1
+        PAULI_CHANNEL_1(0.18, 0.08, 0.02) 0
+        Z_ERROR(0.05) 0
+        MPP X0*X1
+        MPP Z0*Z1
+        DETECTOR rec[-2]
+        DETECTOR rec[-1]
+    )CIRCUIT");
+    NonbinaryDem nb = circuit_to_nonbinary_dem(c);
+    ASSERT_EQ(nb.columns.size(), 2);
+    size_t rank2 = 0, rank1 = 0;
+    for (const auto &col : nb.columns) {
+        if (col.rank == 2) {
+            rank2++;
+            ASSERT_TRUE(col.factorized);
+            ASSERT_EQ(col.parts.size(), 2);
+            // The parts are the independent X' and Y' components.
+            double p1 = col.parts[0].probability;
+            double p2 = col.parts[1].probability;
+            ASSERT_NEAR(std::min(p1, p2), 0.1, 1e-12);
+            ASSERT_NEAR(std::max(p1, p2), 0.2, 1e-12);
+        } else if (col.rank == 1) {
+            rank1++;
+            ASSERT_EQ(col.parts.size(), 1);
+            ASSERT_NEAR(col.parts[0].probability, 0.05, 1e-12);
+        }
+    }
+    ASSERT_EQ(rank2, 1);
+    ASSERT_EQ(rank1, 1);
+}
