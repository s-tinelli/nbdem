index 0000000..e1eaf22
--- /dev/null
+++ b/src/stim/util_top/circuit_to_nb_dem.test.cc
@@ -0,0 +1,585 @@
+/*
+ * Tests for the non-binary detector error model construction.
+ *
+ * Copyright 2026 DLR.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "stim/util_top/circuit_to_nb_dem.h"
+
+#include <cmath>
+#include <random>
+#include <set>
+
+#include "gtest/gtest.h"
+#include "stim/util_top/circuit_to_dem.h"
+
+using namespace stim;
+
+namespace {
+
+/// Compares the error instructions of two detector error models (allowing a
+/// probability tolerance, since the XOR-merge order differs).
+void expect_dem_errors_equal(const DetectorErrorModel &a, const DetectorErrorModel &b) {
+    auto errors_of = [](const DetectorErrorModel &m) {
+        std::vector<std::pair<std::vector<DemTarget>, double>> out;
+        for (const auto &e : m.instructions) {
+            if (e.type != DemInstructionType::DEM_ERROR) {
+                continue;
+            }
+            std::vector<DemTarget> targets(e.target_data.begin(), e.target_data.end());
+            out.push_back({targets, e.arg_data[0]});
+        }
+        return out;
+    };
+    auto ea = errors_of(a);
+    auto eb = errors_of(b);
+    ASSERT_EQ(ea.size(), eb.size());
+    for (size_t k = 0; k < ea.size(); k++) {
+        ASSERT_EQ(ea[k].first, eb[k].first) << "Target mismatch at error " << k;
+        ASSERT_NEAR(ea[k].second, eb[k].second, 1e-12) << "Probability mismatch at error " << k;
+    }
+}
+
+/// Computes E[(-1)^{<f, (s, l)>}] for a non-binary dem, where f selects a set
+/// of detectors and observables.
+double nb_parity_expectation(
+    const NonbinaryDem &nb, const std::vector<bool> &det_mask, const std::vector<bool> &obs_mask) {
+    double result = 1;
+    for (const auto &col : nb.columns) {
+        uint64_t t = 0;
+        for (const auto &[d, label] : col.detector_edges) {
+            if (det_mask[d]) {
+                t ^= label;
+            }
+        }
+        for (const auto &[o, label] : col.observable_edges) {
+            if (obs_mask[o]) {
+                t ^= label;
+            }
+        }
+        if (t == 0) {
+            continue;
+        }
+        double acc = 0;
+        for (size_t u = 0; u < col.prior.size(); u++) {
+            acc += col.prior[u] * (((__builtin_popcountll(t & u) & 1) == 1) ? -1.0 : 1.0);
+        }
+        result *= acc;
+    }
+    return result;
+}
+
+/// Computes E[(-1)^{<f, (s, l)>}] for a binary detector error model.
+double dem_parity_expectation(
+    const DetectorErrorModel &dem, const std::vector<bool> &det_mask, const std::vector<bool> &obs_mask) {
+    double result = 1;
+    for (const auto &e : dem.instructions) {
+        if (e.type != DemInstructionType::DEM_ERROR) {
+            continue;
+        }
+        size_t hits = 0;
+        for (const auto &t : e.target_data) {
+            if (t.is_relative_detector_id() && det_mask[t.raw_id()]) {
+                hits++;
+            }
+            if (t.is_observable_id() && obs_mask[t.raw_id()]) {
+                hits++;
+            }
+        }
+        if (hits & 1) {
+            result *= 1 - 2 * e.arg_data[0];
+        }
+    }
+    return result;
+}
+
+/// Checks that the non-binary dem is equivalent to Stim's binary dem for all
+/// parity expectations, on random masks. This is the paper's exactness check.
+void expect_nb_equivalent_to_stim_dem(
+    const Circuit &circuit, size_t num_checks = 25, bool approximate_disjoint_errors = false) {
+    NonbinaryDem nb = circuit_to_nonbinary_dem(circuit);
+    DemOptions dem_opts;
+    dem_opts.approximate_disjoint_errors_threshold = approximate_disjoint_errors ? 1 : 0;
+    DetectorErrorModel dem = circuit_to_dem(circuit, dem_opts).flattened();
+    expect_dem_errors_equal(nb.binary_image(), dem);
+    std::mt19937 rng(0);
+    for (size_t k = 0; k < num_checks; k++) {
+        std::vector<bool> det_mask(nb.num_detectors);
+        std::vector<bool> obs_mask(nb.num_observables);
+        for (size_t d = 0; d < det_mask.size(); d++) {
+            det_mask[d] = (rng() & 1) != 0;
+        }
+        for (size_t o = 0; o < obs_mask.size(); o++) {
+            obs_mask[o] = (rng() & 1) != 0;
+        }
+        ASSERT_NEAR(nb_parity_expectation(nb, det_mask, obs_mask), dem_parity_expectation(dem, det_mask, obs_mask), 1e-12);
+    }
+    // Structural invariants.
+    for (const auto &col : nb.columns) {
+        double total = 0;
+        for (double p : col.prior) {
+            ASSERT_GE(p, -1e-12);
+            total += p;
+        }
+        ASSERT_NEAR(total, 1, 1e-9);
+        ASSERT_EQ(col.prior.size(), 1ULL << col.rank);
+    }
+}
