+TEST(nb_dem, 422_code_example) {
+    // One round of syndrome extraction on the [[4,2,2]] code, with the three
+    // fault locations highlighted in the paper's example: a depolarizing
+    // channel I on a data qubit before the round, a two-qubit depolarizing
+    // channel C after the CNOT from that data qubit to the Z ancilla, and a
+    // measurement flip M on the Z ancilla.
+    Circuit c(R"CIRCUIT(
+        R 0 1 2 3 4 5
+        H 0
+        CX 0 1
+        CX 0 2
+        CX 0 3
+        H 5
+        DEPOLARIZE1(0.03) 1
+        CX 0 4
+        CX 5 1
+        CX 1 4
+        DEPOLARIZE2(0.03) 1 4
+        CX 5 0
+        CX 2 4
+        CX 5 3
+        CX 3 4
+        CX 5 2
+        X_ERROR(0.03) 4
+        M 4
+        MX 5
+        MPP X0*X1*X2*X3
+        M 0 1 2 3
+        DETECTOR rec[-7]
+        DETECTOR rec[-6]
+        DETECTOR rec[-6] rec[-5]
+        DETECTOR rec[-7] rec[-4] rec[-3] rec[-2] rec[-1]
+        OBSERVABLE_INCLUDE(0) rec[-4] rec[-3]
+    )CIRCUIT");
+    expect_nb_equivalent_to_stim_dem(c, 50);
+
+    NonbinaryDem nb = circuit_to_nonbinary_dem(c);
+    // The measurement flip M and the X part of the depolarizing channel I are
+    // degenerate with parts of the two-qubit channel C, so the rank-first
+    // regrouping merges them into the 16-ary column of C.
+    ASSERT_EQ(nb.columns.size(), 1);
+    ASSERT_EQ(nb.columns[0].rank, 4);
+    ASSERT_EQ(nb.columns[0].detector_edges.size(), 4);
+    // The claimed parts reproduce the binary dem's mechanisms.
+    ASSERT_EQ(nb.columns[0].parts.size(), circuit_to_dem(c).flattened().count_errors());
+    // Prior table sums to one and has 16 entries.
+    ASSERT_EQ(nb.columns[0].prior.size(), 16);
+    double total = 0;
+    for (double p : nb.columns[0].prior) {
+        total += p;
+    }
+    ASSERT_NEAR(total, 1.0, 1e-9);
+}
