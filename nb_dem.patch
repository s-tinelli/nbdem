+#include "stim/util_bot/arg_parse.h"
+#include "stim/util_top/circuit_to_nb_dem.h"
+
+using namespace stim;
+
+int stim::command_analyze_errors_nb(int argc, const char **argv) {
+    check_for_unknown_arguments(
+        {
+            "--allow_gauge_detectors",
+            "--in",
+            "--merge",
+            "--format",
+            "--out",
+        },
+        {"--analyze_errors_nb"},
+        "analyze_errors_nb",
+        argc,
+        argv);
+    bool allow_gauge_detectors = find_bool_argument("--allow_gauge_detectors", argc, argv);
+    const char *merge_arg = find_argument("--merge", argc, argv);
+    NbDemOptions options;
+    if (merge_arg == nullptr || *merge_arg == '\0' || strcmp(merge_arg, "parts") == 0) {
+        options.merge = NbDemMergeMode::PARTS;
+    } else if (strcmp(merge_arg, "columns") == 0) {
+        options.merge = NbDemMergeMode::COLUMNS;
+    } else if (strcmp(merge_arg, "none") == 0) {
+        options.merge = NbDemMergeMode::NONE;
+    } else {
+        std::stringstream msg;
+        msg << " unrecognized value '" << merge_arg << "'";
+        throw std::invalid_argument(msg.str());
+    }
+    options.allow_gauge_detectors = allow_gauge_detectors;
+    bool json = false;
+    const char *format_arg = find_argument("--format", argc, argv);
+    if (format_arg == nullptr || *format_arg == '\0' || strcmp(format_arg, "text") == 0) {
+        json = false;
+    } else if (strcmp(format_arg, "json") == 0) {
+        json = true;
+    } else {
+        std::stringstream msg;
+        msg << " unrecognized value '" << format_arg << "'";
+        throw std::invalid_argument(msg.str());
+    }
+
+    FILE *in = find_open_file_argument("--in", stdin, "rb", argc, argv);
+    auto out_stream = find_output_stream_argument("--out", true, argc, argv);
+    std::ostream &out = out_stream.stream();
+    auto circuit = Circuit::from_file(in);
+    if (in != stdin) {
+        fclose(in);
+    }
+    auto model = circuit_to_nonbinary_dem(circuit, options);
+    out << (json ? model.to_json() : model.str()) << "\n";
+    return EXIT_SUCCESS;
+}
+
+SubCommandHelp stim::command_analyze_errors_nb_help() {
+    SubCommandHelp result;
+    result.subcommand_name = "analyze_errors_nb";
+    result.description = "Converts a circuit into a non-binary detector error model.";
+
+    result.examples.push_back(clean_doc_string(R"PARAGRAPH(
+            >>> cat example_circuit.stim
+            R 0 1
+            H 0
+            CX 0 1
+            DEPOLARIZE1(0.03) 0
+            MPP X0*X1
+            MPP Z0*Z1
+            DETECTOR rec[-2]
+            DETECTOR rec[-1]
+
+            >>> stim analyze_errors_nb --in example_circuit.stim
+            nb_detector_error_model num_detectors=2 num_observables=0
+            merge=parts num_columns=1
+            column[0] rank=2 factorized=yes
+              prior 0.97 0.01 0.01 0.01
+              det_edge D0 X
+              det_edge D1 Z
+              generator X@0
+              generator Z@0
+              origin DEPOLARIZE1(0.03) 0
+              part 0.0101020514433644 D0
+              part 0.0101020514433644 D1
+              part 0.0101020514433644 D0 D1
+        )PARAGRAPH"));
+
+    result.flags.push_back(
+        {"--merge",
+         "str",
+         "parts",
+         {"parts", "columns", "none"},
+         "How columns are merged:\n"
+         "    parts: full split-merge-regroup (default; exact, most compact)\n"
+         "    columns: only merge columns with equal span\n"
+         "    none: one raw column per noise channel application"});
+    result.flags.push_back(
+        {"--format",
+         "str",
+         "text",
+         {"text", "json"},
+         "Output format of the non-binary detector error model."});
+    result.flags.push_back(
+        {"--in",
+         "",
+         "",
+         {},
+         "Uses this circuit file, instead of stdin."});
+    result.flags.push_back(
+        {"--out",
+         "",
+         "",
+         {},
+         "Writes the model to this file, instead of stdout."});
+    result.flags.push_back(
+        {"--allow_gauge_detectors",
+         "",
+         "",
+         {},
+         "Allows non-deterministic detectors to be replaced by 50/50 error mechanisms instead of failing."});
+
+    return result;
+}
