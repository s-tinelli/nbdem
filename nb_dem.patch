+TEST(nb_dem, else_chain_is_one_exact_column) {
+    // An E/ELSE chain is one raw column with the exact disjoint prior.
+    Circuit c(R"CIRCUIT(
+        R 0 1 2 3
+        E(0.1) X0 X1
+        ELSE_CORRELATED_ERROR(0.2) X2
+        ELSE_CORRELATED_ERROR(0.3) Y3
+        M 0 1 2 3
+        DETECTOR rec[-4]
+        DETECTOR rec[-2]
+        DETECTOR rec[-1]
+    )CIRCUIT");
+    NbDemOptions opts;
+    opts.merge = NbDemMergeMode::NONE;
+    NonbinaryDem nb = circuit_to_nonbinary_dem(c, opts);
+    // Generators: X@0, X@1, X@2, X@3, Z@3. The three alternatives have the
+    // independent symptoms X0X1, X2, Y3 -> rank 3.
+    ASSERT_EQ(nb.columns.size(), 1);
+    ASSERT_EQ(nb.columns[0].rank, 3);
+    ASSERT_FALSE(nb.columns[0].factorized);
+    // Exact prior: P(000) = 0.9*0.8*0.7, P(X0X1) = 0.1, P(Z2) = 0.9*0.2, P(Y3) = 0.9*0.8*0.3.
+    double total = 0;
+    for (double p : nb.columns[0].prior) {
+        total += p;
+    }
+    ASSERT_NEAR(total, 1.0, 1e-12);
+}
