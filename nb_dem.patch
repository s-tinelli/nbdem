+#include "stim/util_top/circuit_to_nb_dem.pybind.h"
+
+#include "stim/dem/detector_error_model.pybind.h"
+
+using namespace stim;
+using namespace stim_pybind;
+
+pybind11::dict column_to_dict(const NbDemColumn &col) {
+    pybind11::dict out;
+    out["rank"] = col.rank;
+    out["factorized"] = col.factorized;
+    pybind11::list prior;
+    for (double p : col.prior) {
+        prior.append(p);
+    }
+    out["prior"] = prior;
+    pybind11::list det_edges;
+    for (const auto &[d, label] : col.detector_edges) {
+        det_edges.append(pybind11::make_tuple(d, label));
+    }
+    out["detector_edges"] = det_edges;
+    pybind11::list obs_edges;
+    for (const auto &[o, label] : col.observable_edges) {
+        obs_edges.append(pybind11::make_tuple(o, label));
+    }
+    out["observable_edges"] = obs_edges;
+    pybind11::list labels;
+    for (const auto &g : col.generator_labels) {
+        labels.append(g);
+    }
+    out["generator_labels"] = labels;
+    pybind11::list origins;
+    for (const auto &g : col.origins) {
+        origins.append(g);
+    }
+    out["origins"] = origins;
+    pybind11::list parts;
+    for (const auto &part : col.parts) {
+        pybind11::dict pd;
+        pd["probability"] = part.probability;
+        pybind11::list dets;
+        for (uint32_t d : part.flipped_detectors) {
+            dets.append(d);
+        }
+        pd["flipped_detectors"] = dets;
+        pybind11::list obs;
+        for (uint32_t o : part.flipped_observables) {
+            obs.append(o);
+        }
+        pd["flipped_observables"] = obs;
+        pd["origin"] = part.origin;
+        parts.append(pd);
+    }
+    out["parts"] = parts;
+    return out;
+}
+
+pybind11::class_<NonbinaryDem> stim_pybind::pybind_nonbinary_dem(pybind11::module &m) {
+    return pybind11::class_<NonbinaryDem>(
+        m,
+        "NonbinaryDem",
+        clean_doc_string(R"DOC(
+            A non-binary detector error model.
+
+            Each column of the model is a random variable u in F_2^r with a prior
+            distribution over its 2^r values, together with linear maps H_c, L_c
+            from F_2^r into detectors and observables. The variables are
+            independent and
+
+                s = sum_c H_c u_c        (syndrome)
+                l = sum_c L_c u_c        (logical flips)
+
+            The detector d is flipped by u iff popcount(label_and_u) is odd,
+            where the label is the row of H_c stored on the detector's edge.
+
+            Examples:
+                >>> import stim
+                >>> circuit = stim.Circuit('''
+                ...     R 0 1
+                ...     DEPOLARIZE2(0.01) 0 1
+                ...     M 0 1
+                ...     DETECTOR rec[-2]
+                ...     DETECTOR rec[-1]
+                ... ''')
+                >>> model = circuit.nonbinary_detector_error_model()
+                >>> len(model)
+                1
+        )DOC")
+            .data());
+}
+
+namespace {
+
+void pybind_nonbinary_dem_methods(pybind11::module &m, pybind11::class_<NonbinaryDem> &c) {
+    c.def(
+        "to_dict",
+        [](const NonbinaryDem &self) {
+            pybind11::dict out;
+            out["num_detectors"] = self.num_detectors;
+            out["num_observables"] = self.num_observables;
+            out["merge"] = self.merge == NbDemMergeMode::NONE
+                ? "none"
+                : (self.merge == NbDemMergeMode::COLUMNS ? "columns" : "parts");
+            pybind11::list cols;
+            for (const auto &col : self.columns) {
+                cols.append(column_to_dict(col));
+            }
+            out["columns"] = cols;
+            return out;
+        },
+        clean_doc_string(R"DOC(
+            Returns a JSON-serializable dictionary describing the model.
+
+            Each column is described by its rank, prior (2^rank probabilities),
+            detector and observable edges with their labels, generator labels,
+            origins, and the binary parts it claimed during construction.
+        )DOC")
+            .data());
+
+    c.def(
+        "to_json",
+        [](const NonbinaryDem &self) {
+            return self.to_json();
+        },
+        clean_doc_string(R"DOC(
+            Returns the model as a JSON string.
+        )DOC")
+            .data());
+
+    c.def(
+        "binary_image",
+        [](const NonbinaryDem &self) {
+            return self.binary_image();
+        },
+        clean_doc_string(R"DOC(
+            Returns the merged binary parts as a stim.DetectorErrorModel.
+
+            This is the "binary image" of the model: for circuits whose channels
+            factorize it is statistically identical to Stim's detector error
+            model. Only error instructions are included.
+        )DOC")
+            .data());
+
+    c.def(
+        "num_columns",
+        [](const NonbinaryDem &self) {
+            return self.columns.size();
+        },
+        clean_doc_string(R"DOC(
+            Returns the number of columns (variable nodes) of the model.
+        )DOC")
+            .data());
+
+    c.def(
+        "num_detector_edges",
+        [](const NonbinaryDem &self) {
+            return self.num_detector_edges();
+        },
+        clean_doc_string(R"DOC(
+            Returns the number of detector-variable edges of the Tanner graph.
+        )DOC")
+            .data());
+
+    c.def(
+        "column",
+        [](const NonbinaryDem &self, size_t index) {
+            if (index >= self.columns.size()) {
+                throw std::invalid_argument("Column index out of range.");
+            }
+            return column_to_dict(self.columns[index]);
+        },
+        clean_doc_string(R"DOC(
+            Returns a dictionary describing one column of the model.
+
+            Args:
+                index: The index of the column.
+        )DOC")
+            .data());
+
+    c.def("__len__", [](const NonbinaryDem &self) {
+        return self.columns.size();
+    });
+
+    c.def("__str__", [](const NonbinaryDem &self) {
+        return self.str();
+    });
+
+    c.def_readonly("num_detectors", &NonbinaryDem::num_detectors, "The number of detectors.");
+    c.def_readonly("num_observables", &NonbinaryDem::num_observables, "The number of observables.");
+}
+
+}  // namespace
+
+// Called from stim.pybind.cc after pybind_nonbinary_dem.
+void stim_pybind::pybind_nonbinary_dem_method_defs(pybind11::module &m) {
+    auto c = pybind_nonbinary_dem(m);
+    pybind_nonbinary_dem_methods(m, c);
+}
