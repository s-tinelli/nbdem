+++ b/src/stim/util_top/circuit_to_nb_dem.cc
@@ -0,0 +1,1484 @@
+/*
+ * Non-binary detector error models: construction from a circuit.
+ *
+ * See circuit_to_nb_dem.h for the API documentation, and
+ * "Non-Binary Detector Error Models" for the algorithm (split, merge and
+ * regroup).
+ *
+ * Copyright 2026 DLR.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "stim/util_top/circuit_to_nb_dem.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "stim/simulators/error_analyzer.h"
+#include "stim/stabilizers/pauli_string.h"
+
+using namespace stim;
+
+namespace {
+
+constexpr size_t MAX_RANK = 16;
+
+/// A symptom: a bitset over detectors (bits [0, num_detectors)) and
+/// observables (bits [num_detectors, num_detectors + num_observables)).
+struct Symptom {
+    std::vector<uint64_t> words;
+    size_t num_bits;
+
+    explicit Symptom(size_t bits) : words((bits + 63) / 64, 0), num_bits(bits) {}
+
+    inline bool get(size_t bit) const {
+        return (words[bit >> 6] >> (bit & 63)) & 1;
+    }
+
+    inline void set(size_t bit) {
+        words[bit >> 6] |= 1ULL << (bit & 63);
+    }
+
+    inline bool is_zero() const {
+        for (uint64_t w : words) {
+            if (w) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    inline void xor_with(const Symptom &other) {
+        for (size_t k = 0; k < words.size(); k++) {
+            words[k] ^= other.words[k];
+        }
+    }
+
+    inline bool operator==(const Symptom &other) const {
+        return words == other.words;
+    }
+
+    inline bool operator<(const Symptom &other) const {
+        return words < other.words;
+    }
+};
+
+struct NbDemContext {
+    size_t num_detectors;
+    size_t num_observables;
+    inline size_t num_bits() const {
+        return num_detectors + num_observables;
+    }
+};
+
+/// Converts a range of sorted DemTargets (from the error analyzer's tracker)
+/// into a Symptom. Targets hold absolute detector/observable ids.
+Symptom symptom_from_targets(const NbDemContext &ctx, SpanRef<const DemTarget> targets) {
+    Symptom result(ctx.num_bits());
+    for (const auto &t : targets) {
+        if (t.is_relative_detector_id()) {
+            if (t.raw_id() >= ctx.num_detectors) {
+                throw std::invalid_argument("Detector id out of range in error symptom.");
+            }
+            result.set(t.raw_id());
+        } else if (t.is_observable_id()) {
+            size_t obs = t.raw_id();
+            if (obs >= ctx.num_observables) {
+                throw std::invalid_argument("Observable id out of range in error symptom.");
+            }
+            result.set(ctx.num_detectors + obs);
+        } else {
+            throw std::invalid_argument("Unexpected separator target in error symptom.");
+        }
+    }
+    return result;
+}
+
+/// Splits a symptom into sorted detector and observable index lists.
+void symptom_to_lists(
+    const NbDemContext &ctx, const Symptom &s, std::vector<uint32_t> &dets, std::vector<uint32_t> &obs) {
+    dets.clear();
+    obs.clear();
+    for (size_t b = 0; b < ctx.num_detectors; b++) {
+        if (s.get(b)) {
+            dets.push_back((uint32_t)b);
+        }
+    }
+    for (size_t b = 0; b < ctx.num_observables; b++) {
+        if (s.get(ctx.num_detectors + b)) {
+            obs.push_back((uint32_t)b);
+        }
+    }
+}
+
+/// One raw column: one application of a noise channel, before any merging.
+struct RawColumn {
+    /// Location order key: (forward instruction index, sub index).
+    std::pair<size_t, size_t> order;
+    std::string description;
+    std::string tag;
+    std::vector<Symptom> generators;
+    /// (raw coordinate bit mask over generators, probability), positive entries only.
+    std::vector<std::pair<uint64_t, double>> prior;
+    std::vector<std::string> generator_labels;
+};
+
+/// A matrix in reduced row echelon form over symptoms as row vectors.
+/// Canonical form of a subspace; used for span identity and coordinates.
+struct RrefBasis {
+    std::vector<Symptom> rows;
+    std::vector<size_t> pivot_cols;
+
+    inline size_t rank() const {
+        return rows.size();
+    }
+
+    inline bool contains(const Symptom &v) const {
+        return solve_coords(v).second;
+    }
+
+    /// Reduces v against the basis. Returns (coordinates over rows, in_span).
+    std::pair<uint64_t, bool> solve_coords(Symptom v) const {
+        uint64_t coords = 0;
+        for (size_t i = 0; i < rows.size(); i++) {
+            if (v.get(pivot_cols[i])) {
+                v.xor_with(rows[i]);
+                coords |= 1ULL << i;
+            }
+        }
+        return {coords, v.is_zero()};
+    }
+};
+
+/// Canonical reduced row echelon basis of the span of the given vectors.
+/// Zero vectors are ignored.
+RrefBasis canonical_rref(const std::vector<Symptom> &vectors, size_t num_bits) {
+    std::vector<std::vector<uint64_t>> rows;
+    for (const auto &v : vectors) {
+        if (!v.is_zero()) {
+            rows.push_back(v.words);
+        }
+    }
+    std::vector<size_t> pivot_col_of_row;
+    for (size_t col = 0; col < num_bits; col++) {
+        if (pivot_col_of_row.size() == rows.size()) {
+            break;
+        }
+        size_t w = col >> 6;
+        uint64_t bit = 1ULL << (col & 63);
+        size_t pivot = SIZE_MAX;
+        for (size_t r = pivot_col_of_row.size(); r < rows.size(); r++) {
+            if (rows[r][w] & bit) {
+                pivot = r;
+                break;
+            }
+        }
+        if (pivot == SIZE_MAX) {
+            continue;
+        }
+        std::swap(rows[pivot_col_of_row.size()], rows[pivot]);
+        size_t pr = pivot_col_of_row.size();
+        const std::vector<uint64_t> &prow = rows[pr];
+        for (size_t r = 0; r < rows.size(); r++) {
+            if (r != pr && (rows[r][w] & bit)) {
+                for (size_t k = 0; k < prow.size(); k++) {
+                    rows[r][k] ^= prow[k];
+                }
+            }
+        }
+        pivot_col_of_row.push_back(col);
+    }
+    RrefBasis basis;
+    for (size_t r = 0; r < pivot_col_of_row.size(); r++) {
+        Symptom s(num_bits);
+        s.words = rows[r];
+        basis.rows.push_back(std::move(s));
+        basis.pivot_cols.push_back(pivot_col_of_row[r]);
+    }
+    return basis;
+}
+
+/// An (arbitrary, ordered) basis with a solver for coordinates, built by
+/// Gaussian elimination on rows augmented with unit coefficient masks.
+struct AugmentedBasis {
+    std::vector<Symptom> rows;
+    std::vector<uint64_t> coeffs;  // coefficient masks over the original basis order
+    std::vector<size_t> pivot_cols;
+
+    /// Solves v = xor of basis[i] for i in the returned mask.
+    std::pair<uint64_t, bool> solve(const Symptom &v) const {
+        Symptom cur = v;
+        uint64_t x = 0;
+        for (size_t i = 0; i < rows.size(); i++) {
+            if (cur.get(pivot_cols[i])) {
+                cur.xor_with(rows[i]);
+                x ^= coeffs[i];
+            }
+        }
+        return {x, cur.is_zero()};
+    }
+};
+
+AugmentedBasis make_augmented_basis(const std::vector<Symptom> &basis, size_t num_bits) {
+    std::vector<std::vector<uint64_t>> rows;
+    std::vector<uint64_t> coeffs;
+    for (size_t i = 0; i < basis.size(); i++) {
+        if (!basis[i].is_zero()) {
+            rows.push_back(basis[i].words);
+            coeffs.push_back(1ULL << i);
+        }
+    }
+    std::vector<size_t> pivot_col_of_row;
+    for (size_t col = 0; col < num_bits; col++) {
+        if (pivot_col_of_row.size() == rows.size()) {
+            break;
+        }
+        size_t w = col >> 6;
+        uint64_t bit = 1ULL << (col & 63);
+        size_t pivot = SIZE_MAX;
+        for (size_t r = pivot_col_of_row.size(); r < rows.size(); r++) {
+            if (rows[r][w] & bit) {
+                pivot = r;
+                break;
+            }
+        }
+        if (pivot == SIZE_MAX) {
+            continue;
+        }
+        std::swap(rows[pivot_col_of_row.size()], rows[pivot]);
+        std::swap(coeffs[pivot_col_of_row.size()], coeffs[pivot]);
+        size_t pr = pivot_col_of_row.size();
+        const std::vector<uint64_t> &prow = rows[pr];
+        for (size_t r = 0; r < rows.size(); r++) {
+            if (r != pr && (rows[r][w] & bit)) {
+                for (size_t k = 0; k < prow.size(); k++) {
+                    rows[r][k] ^= prow[k];
+                }
+                coeffs[r] ^= coeffs[pr];
+            }
+        }
+        pivot_col_of_row.push_back(col);
+    }
+    AugmentedBasis out;
+    for (size_t r = 0; r < pivot_col_of_row.size(); r++) {
+        Symptom s(num_bits);
+        s.words = rows[r];
+        out.rows.push_back(std::move(s));
+        out.coeffs.push_back(coeffs[r]);
+        out.pivot_cols.push_back(pivot_col_of_row[r]);
+    }
+    return out;
+}
+
+/// A column during the construction, after reduction (and span merging).
+struct WorkColumn {
+    std::pair<size_t, size_t> order;
+    std::vector<std::string> origins;
+    std::string tag;
+    std::vector<Symptom> native_generators;
+    std::vector<std::string> native_labels;
+    size_t rank = 0;
+    std::vector<double> prior;  // over the canonical rref basis coordinates
+    RrefBasis basis;            // canonical basis of the column's span
+    /// Symptom of each coordinate value (size 2^rank).
+    std::vector<Symptom> symptom_of_coord;
+    bool factorized = true;
+};
+
+double xor_merge_probs(double a, double b) {
+    return a * (1 - b) + (1 - a) * b;
+}
+
+/// XOR-convolution of two priors over F_2^rank (in a common basis).
+std::vector<double> xor_convolve(const std::vector<double> &a, const std::vector<double> &b) {
+    std::vector<double> out(a.size(), 0.0);
+    for (size_t u1 = 0; u1 < a.size(); u1++) {
+        if (a[u1] == 0) {
+            continue;
+        }
+        for (size_t u2 = 0; u2 < b.size(); u2++) {
+            if (b[u2] != 0) {
+                out[u1 ^ u2] += a[u1] * b[u2];
+            }
+        }
+    }
+    return out;
+}
+
+/// Reduces a raw column to the span of its support. Returns false if the
+/// column flips no detector and no observable (it must be dropped).
+bool reduce_raw_column(const NbDemContext &ctx, const RawColumn &raw, WorkColumn &out) {
+    // Merge support points with equal symptoms. Unlisted probability mass is
+    // the identity outcome, which flips nothing (zero symptom).
+    std::map<std::vector<uint64_t>, double> by_symptom;
+    double listed_total = 0;
+    for (const auto &[coords, p] : raw.prior) {
+        if (p <= 0) {
+            continue;
+        }
+        Symptom s(ctx.num_bits());
+        for (size_t g = 0; g < raw.generators.size(); g++) {
+            if ((coords >> g) & 1) {
+                s.xor_with(raw.generators[g]);
+            }
+        }
+        by_symptom[s.words] += p;
+        listed_total += p;
+    }
+    if (by_symptom.empty()) {
+        return false;
+    }
+    if (1 - listed_total > 1e-12) {
+        by_symptom[std::vector<uint64_t>((ctx.num_bits() + 63) / 64, 0)] += 1 - listed_total;
+    }
+    std::vector<Symptom> nonzero;
+    for (const auto &[w, p] : by_symptom) {
+        Symptom s(ctx.num_bits());
+        s.words = w;
+        if (!s.is_zero()) {
+            nonzero.push_back(std::move(s));
+        }
+    }
+    if (nonzero.empty()) {
+        return false;  // Invisible column.
+    }
+    out.basis = canonical_rref(nonzero, ctx.num_bits());
+    out.rank = out.basis.rank();
+    if (out.rank > MAX_RANK) {
+        throw std::invalid_argument(
+            "Non-binary DEM: a fault location reduced to rank " + std::to_string(out.rank) +
+            " > " + std::to_string(MAX_RANK) + ", which is not supported.");
+    }
+    out.prior.assign(1ULL << out.rank, 0.0);
+    for (const auto &[w, p] : by_symptom) {
+        Symptom s(ctx.num_bits());
+        s.words = w;
+        auto [coords, in_span] = out.basis.solve_coords(s);
+        if (!in_span) {
+            throw std::invalid_argument("Internal error: support point outside its own span.");
+        }
+        out.prior[coords] += p;
+    }
+    double total = 0;
+    for (double p : out.prior) {
+        total += p;
+    }
+    if (std::abs(total - 1.0) > 1e-9) {
+        throw std::invalid_argument(
+            "Non-binary DEM: channel probabilities of '" + raw.description +
+            "' sum to " + std::to_string(total) + " instead of 1.");
+    }
+    out.symptom_of_coord.assign(1ULL << out.rank, Symptom(ctx.num_bits()));
+    for (size_t u = 0; u < out.symptom_of_coord.size(); u++) {
+        for (size_t i = 0; i < out.rank; i++) {
+            if ((u >> i) & 1) {
+                out.symptom_of_coord[u].xor_with(out.basis.rows[i]);
+            }
+        }
+    }
+    out.order = raw.order;
+    out.origins = {raw.description};
+    out.tag = raw.tag;
+    out.native_generators = raw.generators;
+    out.native_labels = raw.generator_labels;
+    return true;
+}
+
+/// Tries to write the prior (over F_2^rank coordinates) as the XOR of
+/// independent binary parts. Returns part probabilities indexed by
+/// coordinate value (index 0 unused).
+bool try_factorize(const std::vector<double> &prior, size_t rank, std::vector<double> &out_part_probs) {
+    size_t n = 1ULL << rank;
+    if (rank == 1) {
+        out_part_probs.assign(2, 0.0);
+        out_part_probs[1] = prior[1];
+        return true;
+    }
+    std::vector<double> chi(n, 0.0);
+    for (size_t a = 0; a < n; a++) {
+        double acc = 0;
+        for (size_t u = 0; u < n; u++) {
+            acc += prior[u] * (((__builtin_popcountll(a & u) & 1) == 1) ? -1.0 : 1.0);
+        }
+        chi[a] = acc;
+    }
+    out_part_probs.assign(n, 0.0);
+    std::vector<double> ln_chi(n, 0.0);
+    for (size_t a = 1; a < n; a++) {
+        if (chi[a] < 1e-13) {
+            return false;  // No factorization with q_v in [0, 1/2).
+        }
+        ln_chi[a] = std::log(chi[a]);
+    }
+    double scale = std::ldexp(1.0, -(double)(rank - 1));
+    for (size_t v = 1; v < n; v++) {
+        // log(1 - 2 q_v) = -2^{1-r} * sum_{a != 0} (-1)^{<a,v>} log chi_a
+        double acc = 0;
+        for (size_t a = 1; a < n; a++) {
+            acc += ((__builtin_popcountll(a & v) & 1) == 1) ? -ln_chi[a] : ln_chi[a];
+        }
+        double one_minus_2q = std::exp(-scale * acc);
+        if (!(one_minus_2q >= -1e-12) || one_minus_2q > 1 + 1e-12) {
+            return false;
+        }
+        if (one_minus_2q < 0) {
+            one_minus_2q = 0;
+        }
+        if (one_minus_2q > 1) {
+            one_minus_2q = 1;
+        }
+        double q = (1 - one_minus_2q) * 0.5;
+        if (q >= 0.5) {
+            return false;
+        }
+        // Snap probabilities that only reflect floating point noise (the
+        // exact value is 0, but the character formula reproduces it only up
+        // to rounding) so that zero-probability parts are not emitted.
+        out_part_probs[v] = q < 1e-12 ? 0.0 : q;
+    }
+    // Numerical safety: the parts must reproduce the characters.
+    for (size_t a = 1; a < n; a++) {
+        double prod = 1.0;
+        for (size_t v = 1; v < n; v++) {
+            if ((__builtin_popcountll(a & v) & 1) == 1) {
+                prod *= 1 - 2 * out_part_probs[v];
+            }
+        }
+        if (std::abs(prod - chi[a]) > 1e-9) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/// A merged binary part during the regrouping step.
+struct MergedPart {
+    Symptom symptom;
+    double prob;
+    std::string tag;
+    std::string origin;
+    std::pair<size_t, size_t> origin_order;
+    int owner = -1;  // index of the claiming work column
+    /// All origin columns (locations whose parts were merged into this one).
+    std::vector<size_t> origins;
+};
+
+/// Data for one output column, ready for assembly.
+struct AssembleColumn {
+    std::pair<size_t, size_t> order;
+    std::vector<std::string> origins;
+    /// True: atoms are independent binary parts (atom probability = Bernoulli q).
+    /// False: atoms are support points of an exact prior (atom probability = mass).
+    bool from_parts;
+    std::vector<std::pair<Symptom, double>> atoms;
+    std::vector<Symptom> native_generators;
+    std::vector<std::string> native_labels;
+    /// For from_parts columns: indices into the global part list.
+    std::vector<size_t> part_ids;
+};
+
+/// Chooses the output basis of a column: prefers native generators (of the
+/// earliest origin) that lie inside the span, then rref rows.
+std::pair<std::vector<Symptom>, std::vector<std::string>> select_output_basis(
+    const std::vector<Symptom> &native_generators,
+    const std::vector<std::string> &native_labels,
+    const RrefBasis &span,
+    size_t num_bits) {
+    std::vector<Symptom> selected;
+    std::vector<std::string> labels;
+    auto try_add = [&](const Symptom &cand, const std::string &label) {
+        if (selected.size() == span.rank()) {
+            return;
+        }
+        std::vector<Symptom> test = selected;
+        test.push_back(cand);
+        if (canonical_rref(test, num_bits).rank() == selected.size() + 1) {
+            selected.push_back(cand);
+            labels.push_back(label);
+        }
+    };
+    for (size_t i = 0; i < native_generators.size(); i++) {
+        if (span.contains(native_generators[i])) {
+            try_add(native_generators[i], native_labels[i]);
+        }
+    }
+    for (const auto &row : span.rows) {
+        try_add(row, "");
+    }
+    if (selected.size() != span.rank()) {
+        throw std::invalid_argument("Internal error: output basis selection failed.");
+    }
+    bool all_native = true;
+    for (const auto &l : labels) {
+        if (l.empty()) {
+            all_native = false;
+            break;
+        }
+    }
+    if (!all_native) {
+        labels.clear();
+    }
+    return {selected, labels};
+}
+
+/// Renders an edge label as a Pauli string when the basis is the native
+/// generator basis of a single-qubit (rank 2: X@q, Z@q) or two-qubit
+/// (rank 4: X@a, Z@a, X@b, Z@b) Pauli channel, using the Kuo-Lai label
+/// convention: the label is the Pauli that the error anticommutes with,
+///     P_{d,c} = X^hz Z^hx per qubit,
+/// where hx is the label's coefficient of the X generator and hz of the Z
+/// generator (the error X^x Z^z anticommutes with X^hz Z^hx iff
+/// <h, u> = hx*x + hz*z = 1). A detector with label Z is flipped by X and Y
+/// errors, one with label X by Z and Y. Bases that do not have this form
+/// (e.g. a two-qubit channel reduced to generators X@a, X@b) are rendered as
+/// bit vectors over the basis.
+std::string render_label(uint64_t label, const std::vector<std::string> &generator_labels, size_t rank) {
+    auto parse = [&](const std::string &s, char &axis, uint32_t &q) -> bool {
+        if (s.size() < 3 || (s[0] != 'X' && s[0] != 'Z') || s[1] != '@') {
+            return false;
+        }
+        char *end;
+        unsigned long long v = std::strtoull(s.c_str() + 2, &end, 10);
+        if (*end != 0) {
+            return false;
+        }
+        axis = s[0];
+        q = (uint32_t)v;
+        return true;
+    };
+    bool pauli = generator_labels.size() == rank && (rank == 2 || rank == 4);
+    char axes[4];
+    uint32_t qs[4];
+    if (pauli) {
+        for (size_t i = 0; i < rank; i++) {
+            if (!parse(generator_labels[i], axes[i], qs[i])) {
+                pauli = false;
+                break;
+            }
+        }
+    }
+    if (pauli && rank == 2) {
+        pauli = axes[0] == 'X' && axes[1] == 'Z' && qs[0] == qs[1];
+    } else if (pauli && rank == 4) {
+        pauli = axes[0] == 'X' && axes[1] == 'Z' && qs[0] == qs[1] && axes[2] == 'X' && axes[3] == 'Z' &&
+            qs[2] == qs[3] && qs[0] != qs[2];
+    }
+    if (pauli) {
+        auto pauli_of = [](uint64_t h_x, uint64_t h_z) -> char {
+            // X^hz Z^hx.
+            if (h_x && h_z) {
+                return 'Y';
+            }
+            return h_x ? 'Z' : (h_z ? 'X' : 'I');
+        };
+        std::stringstream ss;
+        if (rank == 2) {
+            ss << pauli_of(label & 1, (label >> 1) & 1);
+        } else {
+            ss << pauli_of(label & 1, (label >> 1) & 1);
+            ss << pauli_of((label >> 2) & 1, (label >> 3) & 1);
+        }
+        return ss.str();
+    }
+    std::stringstream ss;
+    for (size_t i = 0; i < rank; i++) {
+        ss << ((label >> i) & 1);
+    }
+    return ss.str();
+}
+
+std::string format_double(double v) {
+    char buf[64];
+    snprintf(buf, sizeof(buf), "%.17g", v);
+    return buf;
+}
+
+/// Final assembly step shared by all merge modes.
+NonbinaryDem assemble_nonbinary_dem(
+    const NbDemContext &ctx,
+    NbDemOptions options,
+    std::vector<AssembleColumn> &assemble,
+    std::vector<MergedPart> &parts) {
+    NonbinaryDem result;
+    result.num_detectors = ctx.num_detectors;
+    result.num_observables = ctx.num_observables;
+    result.merge = options.merge;
+
+    for (auto &ac : assemble) {
+        // Span of the atoms.
+        std::vector<Symptom> atom_symptoms;
+        for (auto &[s, p] : ac.atoms) {
+            if (!s.is_zero()) {
+                atom_symptoms.push_back(s);
+            }
+        }
+        RrefBasis span = canonical_rref(atom_symptoms, ctx.num_bits());
+        if (span.rank() == 0) {
+            continue;  // All atoms invisible; drop the column.
+        }
+        size_t rank = span.rank();
+        auto [basis, labels] = select_output_basis(
+            ac.native_generators, ac.native_labels, span, ctx.num_bits());
+        AugmentedBasis solver = make_augmented_basis(basis, ctx.num_bits());
+
+        NbDemColumn out;
+        out.rank = (uint32_t)rank;
+        out.factorized = ac.from_parts;
+        out.origins = ac.origins;
+        out.generator_labels = labels;
+
+        // Prior: for part-based columns start at delta at coordinate 0 and
+        // convolve the parts; for support-based columns the atoms already
+        // include the identity mass, so just push them forward.
+        out.prior.assign(1ULL << rank, 0.0);
+        if (ac.from_parts) {
+            out.prior[0] = 1.0;
+        }
+        if (ac.from_parts) {
+            for (auto &[s, q] : ac.atoms) {
+                auto [coords, ok] = solver.solve(s);
+                if (!ok) {
+                    throw std::invalid_argument("Internal error: part outside rebuilt span.");
+                }
+                // prior <- (1-q)*prior + q*shift(prior, coords).
+                std::vector<double> next(1ULL << rank, 0.0);
+                for (size_t u = 0; u < out.prior.size(); u++) {
+                    next[u] += (1 - q) * out.prior[u];
+                    next[u ^ coords] += q * out.prior[u];
+                }
+                out.prior = std::move(next);
+            }
+        } else {
+            for (auto &[s, mass] : ac.atoms) {
+                auto [coords, ok] = solver.solve(s);
+                if (!ok) {
+                    throw std::invalid_argument("Internal error: support outside span.");
+                }
+                out.prior[coords] += mass;
+            }
+        }
+
+        // Edges: bit b of the symptom of basis row i contributes label bit i.
+        {
+            std::map<size_t, uint64_t> det_label;
+            std::map<size_t, uint64_t> obs_label;
+            for (size_t i = 0; i < basis.size(); i++) {
+                for (size_t b = 0; b < ctx.num_bits(); b++) {
+                    if (basis[i].get(b)) {
+                        if (b < ctx.num_detectors) {
+                            det_label[b] |= 1ULL << i;
+                        } else {
+                            obs_label[b - ctx.num_detectors] |= 1ULL << i;
+                        }
+                    }
+                }
+            }
+            for (auto &[d, label] : det_label) {
+                out.detector_edges.push_back({(uint32_t)d, label});
+            }
+            for (auto &[o, label] : obs_label) {
+                out.observable_edges.push_back({(uint32_t)o, label});
+            }
+        }
+
+        // Parts (for from_parts columns).
+        if (ac.from_parts) {
+            for (size_t pi : ac.part_ids) {
+                const MergedPart &part = parts[pi];
+                NbDemPart p;
+                p.probability = part.prob;
+                p.origin = part.origin;
+                p.tag = part.tag;
+                symptom_to_lists(ctx, part.symptom, p.flipped_detectors, p.flipped_observables);
+                out.parts.push_back(std::move(p));
+            }
+        }
+
+        result.columns.push_back(std::move(out));
+    }
+    return result;
+}
