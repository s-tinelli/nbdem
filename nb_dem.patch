+        if (col.rank == 4) {
+            ASSERT_EQ(col.generator_labels.size(), 4);
+            std::set<std::string> labels;
+            for (const auto &[d, label] : col.detector_edges) {
+                std::string s = nb.str();
+                ASSERT_NE(s.find("det_edge D" + std::to_string(d)), std::string::npos);
+            }
+            // Check that Pauli labels appear in the text output.
+            for (const auto &g : col.generator_labels) {
+                ASSERT_EQ(g[1], '@');
+            }
