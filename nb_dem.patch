+std::string NonbinaryDem::to_json() const {
+    std::stringstream ss;
+    ss << "{\"num_detectors\":" << num_detectors << ",\"num_observables\":" << num_observables
+       << ",\"merge\":\"";
+    switch (merge) {
+        case NbDemMergeMode::NONE:
+            ss << "none";
+            break;
+        case NbDemMergeMode::COLUMNS:
+            ss << "columns";
+            break;
+        case NbDemMergeMode::PARTS:
+            ss << "parts";
+            break;
+    }
+    ss << "\",\"columns\":[";
+    for (size_t c = 0; c < columns.size(); c++) {
+        const auto &col = columns[c];
+        if (c) {
+            ss << ",";
+        }
+        ss << "{\"rank\":" << col.rank << ",\"factorized\":" << (col.factorized ? "true" : "false")
+           << ",\"prior\":[";
+        for (size_t u = 0; u < col.prior.size(); u++) {
+            if (u) {
+                ss << ",";
+            }
+            ss << format_double(col.prior[u]);
+        }
+        ss << "],\"detector_edges\":[";
+        for (size_t e = 0; e < col.detector_edges.size(); e++) {
+            if (e) {
+                ss << ",";
+            }
+            ss << "[" << col.detector_edges[e].first << ",\""
+               << render_label(col.detector_edges[e].second, col.generator_labels, col.rank) << "\"]";
+        }
+        ss << "],\"observable_edges\":[";
+        for (size_t e = 0; e < col.observable_edges.size(); e++) {
+            if (e) {
+                ss << ",";
+            }
+            ss << "[" << col.observable_edges[e].first << ",\""
+               << render_label(col.observable_edges[e].second, col.generator_labels, col.rank) << "\"]";
+        }
+        ss << "],\"generator_labels\":[";
+        for (size_t g = 0; g < col.generator_labels.size(); g++) {
+            if (g) {
+                ss << ",";
+            }
+            ss << "\"" << json_escape(col.generator_labels[g]) << "\"";
+        }
+        ss << "],\"origins\":[";
+        for (size_t o = 0; o < col.origins.size(); o++) {
+            if (o) {
+                ss << ",";
+            }
+            ss << "\"" << json_escape(col.origins[o]) << "\"";
+        }
+        ss << "],\"parts\":[";
+        for (size_t p = 0; p < col.parts.size(); p++) {
+            if (p) {
+                ss << ",";
+            }
+            ss << "{\"probability\":" << format_double(col.parts[p].probability)
+               << ",\"flipped_detectors\":[";
+            for (size_t d = 0; d < col.parts[p].flipped_detectors.size(); d++) {
+                if (d) {
+                    ss << ",";
+                }
+                ss << col.parts[p].flipped_detectors[d];
+            }
+            ss << "],\"flipped_observables\":[";
+            for (size_t d = 0; d < col.parts[p].flipped_observables.size(); d++) {
+                if (d) {
+                    ss << ",";
+                }
+                ss << col.parts[p].flipped_observables[d];
+            }
+            ss << "],\"origin\":\"" << json_escape(col.parts[p].origin) << "\"}";
+        }
+        ss << "]}";
+    }
+    ss << "]}";
+    return ss.str();
+}
+
+std::string NonbinaryDem::str() const {
+    std::stringstream ss;
+    ss << "nb_detector_error_model num_detectors=" << num_detectors << " num_observables=" << num_observables
+       << " merge=";
+    switch (merge) {
+        case NbDemMergeMode::NONE:
+            ss << "none";
+            break;
+        case NbDemMergeMode::COLUMNS:
+            ss << "columns";
+            break;
+        case NbDemMergeMode::PARTS:
+            ss << "parts";
+            break;
+    }
+    ss << " num_columns=" << columns.size() << "\n";
+    for (size_t c = 0; c < columns.size(); c++) {
+        const auto &col = columns[c];
+        ss << "column[" << c << "] rank=" << col.rank << " factorized=" << (col.factorized ? "yes" : "no")
+           << "\n";
+        ss << "  prior";
+        for (double p : col.prior) {
+            ss << " " << format_double(p);
+        }
+        ss << "\n";
+        for (const auto &[d, label] : col.detector_edges) {
+            ss << "  det_edge D" << d << " " << render_label(label, col.generator_labels, col.rank) << "\n";
+        }
+        for (const auto &[o, label] : col.observable_edges) {
+            ss << "  obs_edge L" << o << " " << render_label(label, col.generator_labels, col.rank) << "\n";
+        }
+        for (const auto &g : col.generator_labels) {
+            ss << "  generator " << g << "\n";
+        }
+        for (const auto &o : col.origins) {
+            ss << "  origin " << o << "\n";
+        }
+        for (const auto &part : col.parts) {
+            ss << "  part " << format_double(part.probability);
+            for (uint32_t d : part.flipped_detectors) {
+                ss << " D" << d;
+            }
+            for (uint32_t o : part.flipped_observables) {
+                ss << " L" << o;
+            }
+            ss << "\n";
+        }
+    }
+    return ss.str();
+}
+
+}  // namespace stim
diff --git a/src/stim/util_top/circuit_to_nb_dem.h b/src/stim/util_top/circuit_to_nb_dem.h
new file mode 100644
index 0000000..6d1bde5
--- /dev/null
+++ b/src/stim/util_top/circuit_to_nb_dem.h
@@ -0,0 +1,149 @@
+/*
+ * Non-binary detector error models (NB-DEM).
+ *
+ * Implements the split-merge-regroup construction of
+ * "Non-Binary Detector Error Models" (Tinelli, Lazaro, Garcia Herrero).
+ *
+ * A non-binary DEM is a list of columns (pi_c, H_c, L_c). Column c is a random
+ * variable u_c in F_2^{r_c} with prior pi_c, and
+ *     s = sum_c H_c u_c,   l = sum_c L_c u_c.
+ * Each column of rank r=2/4 corresponds to a single-qubit/two-qubit Pauli
+ * channel with its exact prior (generators X, Z per qubit); rank-1 columns are
+ * ordinary binary mechanisms. The construction splits factorizable columns
+ * into their independent binary parts, merges parts with equal symptoms (as
+ * Stim does), assigns each merged part to its origin location of largest rank
+ * (ties: earlier circuit position), and rebuilds
+ * the locations from their assigned parts, preserving the joint law
+ * P(s, l) exactly.
+ *
+ * Copyright 2026 DLR.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef _STIM_UTIL_TOP_CIRCUIT_TO_NB_DEM_H
+#define _STIM_UTIL_TOP_CIRCUIT_TO_NB_DEM_H
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include "stim/circuit/circuit.h"
+#include "stim/dem/detector_error_model.h"
+
+namespace stim {
+
+/// Which merging steps of the split-merge-regroup procedure to apply.
+enum class NbDemMergeMode {
+    /// One (reduced) raw column per noise channel application. No merging.
+    NONE,
+    /// Only merge columns with equal span (the paper's weaker merging variant).
+    COLUMNS,
+    /// Full split-merge-regroup (default; the paper's Algorithm).
+    PARTS,
+};
+
+/// Options for the non-binary detector error model construction.
+struct NbDemOptions {
+    /// Merging strategy. See NbDemMergeMode.
+    NbDemMergeMode merge = NbDemMergeMode::PARTS;
+    /// When true, non-deterministic detectors are replaced by 50/50 error mechanisms
+    /// instead of causing failure.
+    bool allow_gauge_detectors = false;
+};
+
+/// A binary part (independent mechanism) claimed by a column of the non-binary DEM.
+struct NbDemPart {
+    /// Probability of the part firing.
+    double probability;
+    /// Sorted detector indices flipped by the part.
+    std::vector<uint32_t> flipped_detectors;
+    /// Sorted observable indices flipped by the part.
+    std::vector<uint32_t> flipped_observables;
+    /// Description of the origin location that contributed the part.
+    std::string origin;
+    /// The tag of the noise instruction that contributed the part.
+    std::string tag;
+};
+
+/// One column of a non-binary detector error model.
+struct NbDemColumn {
+    /// The rank r_c of the column (number of basis generators).
+    uint32_t rank = 0;
+    /// The prior pi_c as a table of 2^rank probabilities, indexed by the coordinate
+    /// vector u in F_2^rank (bit i of the index = coefficient of basis generator i).
+    std::vector<double> prior;
+    /// Detector edges: (detector index, label). The label is the row of H_c, stored as
+    /// a bit vector over the basis generators (bit i = coefficient of generator i).
+    /// Detector d is flipped by u iff popcount(label & u) is odd.
+    std::vector<std::pair<uint32_t, uint64_t>> detector_edges;
+    /// Observable edges: (observable index, label), with the same semantics.
+    std::vector<std::pair<uint32_t, uint64_t>> observable_edges;
+    /// The independent binary parts claimed by this column during regrouping.
+    /// Empty for columns that were kept whole (non-factorizable channels).
+    std::vector<NbDemPart> parts;
+    /// False iff the column's channel does not factorize into independent binary
+    /// parts and the column was therefore kept whole with its exact prior.
+    bool factorized = true;
+    /// Descriptions of the origin locations merged into this column.
+    std::vector<std::string> origins;
+    /// Human readable description of the basis generators (e.g. "X@4", "Z@4"),
+    /// when the basis is the native generator basis of a Pauli channel.
+    /// Empty when the basis is a generic reduced basis.
+    std::vector<std::string> generator_labels;
+
+    /// The prior as a probability of each coordinate. Same as `prior`.
+    const std::vector<double> &prior_table() const {
+        return prior;
+    }
+};
+
+/// A non-binary detector error model.
+struct NonbinaryDem {
+    /// The number of detectors in the circuit.
+    size_t num_detectors = 0;
+    /// The number of logical observables in the circuit.
+    size_t num_observables = 0;
+    /// The merge mode used to construct this model.
+    NbDemMergeMode merge = NbDemMergeMode::PARTS;
+    /// The columns of the model.
+    std::vector<NbDemColumn> columns;
+
+    /// The merged binary parts, as a stim.DetectorErrorModel (error instructions only).
+    /// This is the "binary image" of the non-binary DEM: for circuits whose channels
+    /// factorize it is statistically identical to Stim's detector error model.
+    DetectorErrorModel binary_image() const;
+
+    /// Total number of detector-variable edges of the Tanner graph.
+    size_t num_detector_edges() const;
+
+    /// Human readable text format.
+    std::string str() const;
+
+    /// Machine readable JSON format.
+    std::string to_json() const;
+};
+
+/// Computes the non-binary detector error model of a circuit.
+///
+/// Args:
+///     circuit: The circuit to analyze. Its loops are unrolled.
+///     options: Construction options (merge mode, gauge detectors).
+///
+/// Returns:
+///     The non-binary detector error model.
+NonbinaryDem circuit_to_nonbinary_dem(const Circuit &circuit, NbDemOptions options = {});
+
+}  // namespace stim
+
+#endif
