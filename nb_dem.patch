+TEST(nb_dem, label_convention) {
+    // Kuo-Lai convention: the label is the Pauli the error anticommutes
+    // with. A detector flipped by X errors gets label Z, one flipped by Z
+    // errors gets label X (paper: "the labels Z, X and Y mean that the
+    // detector is flipped by X and Y, by Z and Y, or by X and Z").
+    Circuit c(R"CIRCUIT(
+        R 0 1
+        H 0
+        CX 0 1
+        DEPOLARIZE1(0.01) 0
+        MPP X0*X1
+        MPP Z0*Z1
+        DETECTOR rec[-2]
+        DETECTOR rec[-1]
+    )CIRCUIT");
+    NonbinaryDem nb = circuit_to_nonbinary_dem(c);
+    ASSERT_EQ(nb.columns.size(), 1);
+    ASSERT_EQ(nb.columns[0].rank, 2);
+    std::string text = nb.str();
+    // D0 measures X0*X1 (flipped by Z errors on qubit 0): label X.
+    ASSERT_NE(text.find("det_edge D0 X\n"), std::string::npos);
+    // D1 measures Z0*Z1 (flipped by X errors on qubit 0): label Z.
+    ASSERT_NE(text.find("det_edge D1 Z\n"), std::string::npos);
+
+    // A two-qubit channel reduced to generators X@0 and X@1 has no Pauli
+    // basis and must render labels as bit vectors.
+    Circuit c2(R"CIRCUIT(
+        R 0 1
+        X_ERROR(0.125) 0
+        DEPOLARIZE2(0.25) 0 1
+        M 0 1
+        DETECTOR rec[-2]
+        DETECTOR rec[-1]
+    )CIRCUIT");
+    NonbinaryDem nb2 = circuit_to_nonbinary_dem(c2);
+    ASSERT_EQ(nb2.columns.size(), 1);
+    ASSERT_EQ(nb2.columns[0].rank, 2);
+    std::string text2 = nb2.str();
+    ASSERT_NE(text2.find("det_edge D0 10\n"), std::string::npos);
+    ASSERT_NE(text2.find("det_edge D1 01\n"), std::string::npos);
+}
